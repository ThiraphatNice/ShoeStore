<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value=".dotnet\.nuget\packages" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="local-packages">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
