@model ShoeStore.ViewModels.Order.OrderDetailViewModel
@{
    ViewData["Title"] = Model.OrderNumber;
    var shippingText = Model.ShippingStatus?.ToLowerInvariant() switch
    {
        "delivering" => "กำลังจัดส่ง",
        "done" => "จัดส่งแล้ว",
        _ => "กำลังแพ็คสินค้า"
    };
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .detail-wrapper {
            background: #fff;
            border-radius: 28px;
            padding: 24px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.08);
        }

        .timeline {
            display: flex;
            gap: 1rem;
            margin: 1.5rem 0;
        }

        .timeline-step {
            flex: 1;
            text-align: center;
        }

        .timeline-step .icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #f1b3b3;
            color: #b53636;
            font-size: 1.5rem;
            margin-bottom: 0.4rem;
        }

        .timeline-step.active .icon {
            background: #b53636;
            color: #fff;
            border-color: #b53636;
        }

        .detail-section {
            background: #fff8f6;
            border-radius: 18px;
            padding: 1.2rem;
            margin-bottom: 1rem;
        }

        .detail-section h5 {
            font-weight: 700;
        }
    </style>
}

<div class="container py-4">
    <a asp-action="Index" class="btn btn-link text-decoration-none mb-3">← กลับไปประวัติคำสั่งซื้อ</a>
    <div class="detail-wrapper">
        <div class="d-flex justify-content-between flex-wrap gap-2 align-items-center">
            <div>
                <p class="text-muted mb-1">Order Number</p>
                <h2 class="mb-0">@Model.OrderNumber</h2>
                <p class="text-muted">@Model.CreatedAtDisplay</p>
            </div>
            <div class="text-end">
                <span class="fs-5 fw-bold">@Model.FinalAmountDisplay</span>
                <p class="mb-0">วิธีชำระเงิน: <strong>@Model.PaymentMethod</strong></p>
                @if (!string.IsNullOrWhiteSpace(Model.CouponCode))
                {
                    <span class="badge text-bg-light">Coupon: @Model.CouponCode</span>
                }
            </div>
        </div>

        <div class="timeline">
            @foreach (var stage in Model.Timeline)
            {
                var iconClass = stage.IsActive ? "timeline-step active" : "timeline-step";
                <div class="@iconClass">
                    <div class="icon">
                        <i class="bi @stage.Icon"></i>
                    </div>
                    <span>@stage.Label</span>
                    <small class="text-muted">@stage.TimestampDisplay</small>
                </div>
            }
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="detail-section">
                    <h5>ข้อมูลจัดส่ง</h5>
                    <p class="mb-1"><strong>@Model.CustomerName</strong></p>
                    <p class="mb-1">โทร: @Model.CustomerPhone</p>
                    <p class="mb-1">อีเมล: @Model.CustomerEmail</p>
                    <p class="mb-0">ที่อยู่: @Model.CustomerAddress</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="detail-section">
                    <h5>สรุปการชำระเงิน</h5>
                    <p class="mb-1">ราคาสินค้า : @Model.FinalAmountDisplay</p>
                    <p class="mb-1">ส่วนลดคูปอง : @(Model.DiscountPercent.HasValue ? $"{Model.DiscountPercent:N0}%" : "-")</p>
                    <p class="mb-0">สถานะจัดส่ง : @shippingText</p>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <h5>รายการสินค้า</h5>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>สินค้า</th>
                            <th>จำนวน</th>
                            <th class="text-end">ยอดรวม</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.ProductName</strong>
                                    <div class="small text-muted">สี: @item.Color • ไซซ์: @item.Size</div>
                                </td>
                                <td>@item.Quantity</td>
                                <td class="text-end">@item.LineTotalDisplay</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
