<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShoeStore</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/ShoeStore.styles.css" asp-append-version="true" />
    <style>
        html {
            font-size: 14px;
            position: relative;
            min-height: 100%;
        }

        @@media (min-width: 768px) {
            html {
                font-size: 16px;
            }
        }

        body {
            margin: 0;
            font-family: "Poppins", Arial, sans-serif;
            background-color: #fdecec;
            color: #2d2d2d;
        }

        .page-shell {
            min-height: calc(100vh - 140px);
            padding: 40px 24px;
        }

        .main-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer {
            background: #fff;
        }

        .btn:focus,
        .btn:active:focus,
        .btn-link.nav-link:focus,
        .form-control:focus,
        .form-check-input:focus {
            box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #b53636;
        }

        .main-navbar {
            background-color: #7d2424;
            padding: 0.75rem 2rem;
        }

        .main-navbar .navbar-toggler {
            border-color: rgba(255, 255, 255, 0.4);
        }

        .main-navbar .navbar-toggler-icon {
            filter: invert(1);
        }

        .brand-mark {
            color: #fff;
            font-weight: 600;
            font-size: 1.4rem;
        }

        .brand-mark:hover {
            color: #ffe4d9;
        }

        .nav-link-contrast {
            color: #fff !important;
            font-weight: 500;
        }

        .nav-link-contrast:hover,
        .nav-link-contrast:focus {
            color: #ffe4d9 !important;
        }

        .profile-pill {
            padding: 0.4rem 1.2rem;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 999px;
        }

        .eyebrow {
            font-size: 0.8rem;
            letter-spacing: 0.3em;
            color: #c66a6a;
            text-transform: uppercase;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
        var isAdmin = User?.IsInRole("Admin") ?? false;
        var isStaff = User?.IsInRole("Staff") ?? false;
    }
    <header>
        <nav class="navbar navbar-expand-lg main-navbar shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">ShoeStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-flex justify-content-end">
                    <ul class="navbar-nav align-items-lg-center gap-lg-3">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-contrast" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-contrast" asp-area="" asp-controller="Product" asp-action="Index">Search</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-contrast" asp-area="" asp-controller="Cart" asp-action="Index">Cart</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-contrast" asp-area="" asp-controller="Order" asp-action="Index">History</a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-contrast" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a>
                                </li>
                            }
                            @if (isStaff)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-contrast" asp-area="" asp-controller="Staff" asp-action="Index">Staff</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link nav-link-contrast profile-pill" asp-area="" asp-controller="Account" asp-action="Profile">Profile</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-contrast" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="page-shell">
        <main role="main" class="main-content pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ShoeStore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
