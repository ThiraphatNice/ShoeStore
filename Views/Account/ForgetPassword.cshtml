@model ShoeStore.ViewModels.ForgetPasswordViewModel

@{
    ViewData["Title"] = "Forget Password";
}

@section Styles {
    <style>
        .auth-page {
            min-height: calc(100vh - 160px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 16px;
        }

        .auth-card {
            width: min(900px, 100%);
            display: flex;
            background: #fff;
            border-radius: 28px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.18);
            overflow: hidden;
        }

        .auth-panel-left {
            flex: 1 1 35%;
            background: linear-gradient(180deg, #d74242, #8b1f1f);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .auth-panel-text {
            color: #fff;
            font-size: 2rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .auth-panel-right {
            flex: 1 1 65%;
            padding: 48px 40px;
        }

        .auth-title {
            font-weight: 600;
            color: #b53636;
            margin-bottom: 24px;
        }

        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .auth-field label {
            font-weight: 500;
            color: #b53636;
        }

        .auth-field input.form-control {
            border-radius: 16px;
            border: 1px solid #e1e1e1;
            padding: 10px 14px;
            background-color: #f9f9f9;
        }

        .btn-auth-primary {
            align-self: flex-start;
            background: linear-gradient(180deg, #df5d5d, #9e2c2c);
            color: #fff;
            border: none;
            border-radius: 999px;
            padding: 10px 32px;
            font-weight: 600;
            margin-top: 8px;
        }

        .btn-auth-primary:hover {
            color: #fff;
            opacity: 0.93;
        }

        .auth-links {
            display: flex;
            gap: 16px;
            margin-top: 18px;
            font-weight: 500;
        }

        .auth-links a {
            color: #d74343;
        }

        @@media (max-width: 768px) {
            .auth-card {
                flex-direction: column;
            }

            .auth-panel-left {
                width: 100%;
                min-height: 160px;
            }

            .auth-panel-right {
                padding: 32px 24px;
            }

            .btn-auth-primary {
                width: 100%;
                text-align: center;
            }
        }
    </style>
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-panel-left">
            <span class="auth-panel-text">Forgot Password</span>
        </div>
        <div class="auth-panel-right">
            <h2 class="auth-title">Forget Password</h2>
            <form method="post" class="auth-form">
                <div class="auth-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" required>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" type="password" class="form-control" required>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" required>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-auth-primary">Confirm</button>
            </form>
            <div class="auth-links">
                <a href="@Url.Action("Login", "Account")">Back to Login</a>
            </div>
        </div>
    </div>
</div>
