@model ShoeStore.ViewModels.ForgetPasswordViewModel

@{
    ViewData["Title"] = "Forget Password";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-panel-left">
            <span class="auth-panel-text">Forgot Password</span>
        </div>
        <div class="auth-panel-right">
            <h2 class="auth-title">Forget Password</h2>
            <form method="post" class="auth-form">
                <div class="auth-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" required>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" type="password" class="form-control" required>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" required>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-auth-primary">Confirm</button>
            </form>
            <div class="auth-links">
                <a href="@Url.Action("Login", "Account")">Back to Login</a>
            </div>
        </div>
    </div>
</div>
