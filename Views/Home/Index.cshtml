@model ShoeStore.ViewModels.Home.HomePageViewModel
@using ShoeStore.ViewModels.Home
@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <style>
        .home-hero {
            text-align: center;
            padding: 40px 0;
        }

        .home-hero h1 {
            font-size: clamp(2rem, 4vw, 2.6rem);
            font-weight: 600;
            margin-bottom: 12px;
        }

        .home-hero p {
            color: #6a6a6a;
            margin-bottom: 0;
        }

        .product-section {
            margin-top: 40px;
            position: relative;
        }

        .section-heading {
            font-size: 1.5rem;
            font-weight: 600;
            color: #b53636;
            margin-bottom: 20px;
        }

        .product-grid {
            display: flex;
            gap: 20px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            padding: 8px 16px 18px 4px;
            position: relative;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .product-grid::-webkit-scrollbar {
            display: none;
        }

        .product-card {
            background: #fff;
            border-radius: 22px;
            padding: 20px 18px 22px;
            box-shadow: 0 8px 26px rgba(0, 0, 0, 0.08);
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            flex: 0 0 240px;
            scroll-snap-align: start;
            position: relative;
            border: 1px solid transparent;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .product-card:hover,
        .product-card:focus-visible {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
            border-color: rgba(181, 54, 54, 0.15);
            outline: none;
        }

        .product-badge {
            position: absolute;
            top: 16px;
            left: 18px;
            padding: 2px 12px;
            font-size: 0.72rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            border-radius: 999px;
            background: #b53636;
            color: #fff;
        }

        .product-media {
            width: 100%;
            aspect-ratio: 1 / 1;
            border-radius: 20px;
            background: radial-gradient(circle at top, #fff6f3, #f6dcdc);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 18px;
            overflow: hidden;
        }

        .product-media img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

        .product-media img:hover {
            transform: scale(1.02);
        }

        .product-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .product-meta {
            font-size: 0.75rem;
            color: #a55757;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .product-name {
            font-size: 1.05rem;
            font-weight: 600;
            margin: 0;
        }

        .product-desc {
            font-size: 0.85rem;
            color: #6f6f6f;
            min-height: 38px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-card .price {
            color: #b53636;
            font-weight: 600;
            font-size: 1.05rem;
            margin-top: 4px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .product-rail {
            position: relative;
            padding-right: 32px;
        }

        .grid-arrow {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translate(50%, -50%);
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 2px solid #7d2424;
            background: #fff6f3;
            box-shadow: 0 15px 35px rgba(125, 36, 36, 0.25);
            color: #7d2424;
            font-size: 1.6rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .grid-arrow.is-hidden {
            display: none;
        }

        .mobile-more-btn {
            margin: 16px auto 0;
            display: none;
            border: 1px solid #b53636;
            border-radius: 999px;
            background: transparent;
            color: #b53636;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 6px 22px;
            text-transform: uppercase;
        }

        .price--sale {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .price--sale .original {
            font-size: 0.9rem;
            color: #9a9a9a;
            text-decoration: line-through;
        }

        .price--sale .current {
            color: #b53636;
        }

        .product-modal {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
            z-index: 1050;
        }

        .product-modal.is-visible {
            opacity: 1;
            pointer-events: auto;
        }

        .product-modal__backdrop {
            position: absolute;
            inset: 0;
            background: rgba(32, 32, 32, 0.55);
        }

        .product-modal__dialog {
            position: relative;
            z-index: 1;
            background: #fff;
            border-radius: 28px;
            padding: 32px;
            width: min(900px, 92vw);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
        }

        .modal-body {
            display: flex;
            gap: 32px;
        }

        .modal-left,
        .modal-right {
            flex: 1;
        }

        .modal-image {
            background: #f6f1f1;
            border-radius: 24px;
            padding: 16px;
            margin-bottom: 18px;
            text-align: center;
            height: 320px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .modal-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .modal-control {
            margin-bottom: 16px;
        }

        .modal-select-group {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .modal-select-group .select-wrapper {
            flex: 1 1 180px;
            max-width: 220px;
        }

        .select-wrapper label {
            font-weight: 500;
            margin-bottom: 6px;
            display: block;
        }

        .select-wrapper select {
            width: 100%;
            max-width: 220px;
            padding: 10px 14px;
            border-radius: 14px;
            border: 1px solid #d8d8d8;
            font-size: 1rem;
        }

        .qty-control {
            display: inline-flex;
            align-items: center;
            border: 1px solid #d8d8d8;
            border-radius: 999px;
            overflow: hidden;
        }

        .qty-btn {
            width: 38px;
            height: 38px;
            border: none;
            background: #fff;
            color: #b53636;
            font-size: 1.2rem;
            cursor: pointer;
        }

        .qty-control input {
            width: 58px;
            text-align: center;
            border: none;
            background: transparent;
            font-weight: 600;
            font-size: 1rem;
        }

        .modal-right h3 {
            margin-bottom: 12px;
            font-size: 1.4rem;
        }

        .modal-description {
            color: #555;
            margin-bottom: 16px;
        }

        .modal-description:empty {
            display: none;
        }

        .modal-meta {
            list-style: none;
            padding: 0;
            margin: 0 0 18px;
        }

        .modal-meta li {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            color: #555;
        }

        .modal-price {
            display: flex;
            align-items: baseline;
            gap: 12px;
            margin-bottom: 24px;
        }

        .modal-price__original {
            text-decoration: line-through;
            color: #9a9a9a;
        }

        .modal-price__current {
            font-size: 1.8rem;
            font-weight: 600;
            color: #b53636;
        }

        .modal-price__original:empty {
            display: none;
        }

        .add-to-cart-btn {
            border-radius: 999px;
            padding: 10px 26px;
            background: #b53636;
            color: #fff;
            border: none;
            font-weight: 600;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .add-to-cart-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(181, 54, 54, 0.25);
        }

        .modal-close {
            position: absolute;
            top: 18px;
            right: 24px;
            border: none;
            background: transparent;
            font-size: 2rem;
            line-height: 1;
            color: #b53636;
            cursor: pointer;
        }

        body.modal-open {
            overflow: hidden;
        }

        @@media (max-width: 992px) {
            .modal-body {
                flex-direction: column;
            }
        }

        @@media (max-width: 768px) {
            .grid-arrow {
                display: none;
            }

            .mobile-more-btn {
                display: inline-flex;
            }

            .product-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                overflow: visible;
                padding: 0;
                gap: 16px;
            }

            .is-hidden-mobile {
                display: none !important;
            }

            .product-card {
                flex: none;
            }

            .modal-image {
                height: 240px;
            }
        }
    </style>
}
<section class="home-hero">
    <h1>Welcome to Shoes Store</h1>
    @if (!string.IsNullOrEmpty(Model.Username))
    {
        <p>Hello, @Model.Username! Enjoy the latest drops tailored for you.</p>
    }
    else
    {
        <p>Discover curated sneakers, sport shoes, and everyday essentials.</p>
    }
</section>

@if (Model.FeaturedProducts.Any())
{
    var featuredSection = new HomeSectionViewModel
    {
        Title = "Hot Deals",
        Products = Model.FeaturedProducts
    };
    @await Html.PartialAsync("_ProductSection", featuredSection)
}

@if (Model.LimitedProducts.Any())
{
    var limitedSection = new HomeSectionViewModel
    {
        Title = "Limited Edition Spotlight",
        Products = Model.LimitedProducts
    };
    @await Html.PartialAsync("_ProductSection", limitedSection)
}

@foreach (var section in Model.CategorySections)
{
    @await Html.PartialAsync("_ProductSection", section)
}

<div class="product-modal" id="productModal" aria-hidden="true">
    <div class="product-modal__backdrop" data-modal-close></div>
    <div class="product-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="modalProductName">
        <button class="modal-close" type="button" data-modal-close aria-label="Close">&times;</button>
        <div class="modal-body">
            <div class="modal-left">
                <div class="modal-image">
                    <img id="modalProductImage" src="" alt="Selected shoe" />
                </div>
                <div class="modal-control modal-select-group">
                    <div class="select-wrapper">
                        <label for="modalSize" class="form-label">เลือกไซส์</label>
                        <select id="modalSize" class="form-select"></select>
                    </div>
                    <div class="select-wrapper">
                        <label for="modalColorSelect" class="form-label">เลือกสี</label>
                        <select id="modalColorSelect" class="form-select"></select>
                    </div>
                </div>
                <div class="modal-control">
                    <label class="form-label">จำนวน</label>
                    <div class="qty-control">
                        <button class="qty-btn" type="button" data-qty-action="minus">-</button>
                        <input id="modalQuantity" type="text" value="1" readonly>
                        <button class="qty-btn" type="button" data-qty-action="plus">+</button>
                    </div>
                </div>
            </div>
            <div class="modal-right">
                <p class="text-muted mb-1">รหัสสินค้า: <span id="modalSku"></span></p>
                <h3 id="modalProductName"></h3>
                <p class="modal-description" id="modalDescription"></p>
                <ul class="modal-meta">
                    <li><span>สี</span><strong id="modalColorValue"></strong></li>
                    <li><span>สต็อก</span><strong id="modalStock"></strong></li>
                    <li><span>หมวดหมู่</span><strong id="modalCategory"></strong></li>
                </ul>
                <div class="modal-price">
                    <span class="modal-price__current" id="modalCurrentPrice"></span>
                    <span class="modal-price__original" id="modalOriginalPrice"></span>
                </div>
                <button class="btn btn-auth-primary add-to-cart-btn" type="button">เพิ่มสินค้าในตะกร้า</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.cartApi = Object.assign(window.cartApi || {}, {
            addItem: '@Url.Action("AddItem", "Cart")'
        });
    </script>
    <script>
        (() => {
            const body = document.body;
            const modal = document.getElementById('productModal');

            const initGridControls = () => {
                const arrowButtons = document.querySelectorAll('.grid-arrow');

                const updateArrowVisibility = () => {
                    arrowButtons.forEach((button) => {
                        const grid = button.closest('.product-rail')?.querySelector('.product-grid');
                        if (!grid) {
                            button.classList.add('is-hidden');
                            return;
                        }
                        const shouldShow = grid.scrollWidth - grid.clientWidth > 12;
                        button.classList.toggle('is-hidden', !shouldShow);
                    });
                };

                arrowButtons.forEach((button) => {
                    button.addEventListener('click', () => {
                        const grid = button.closest('.product-rail')?.querySelector('.product-grid');
                        if (!grid) {
                            return;
                        }
                        grid.scrollBy({
                            left: grid.clientWidth * 0.85,
                            behavior: 'smooth',
                        });
                    });
                });

                window.addEventListener('resize', updateArrowVisibility);
                updateArrowVisibility();

                const mobileMedia = window.matchMedia('(max-width: 768px)');
                document.querySelectorAll('[data-grid-collapse]').forEach((section) => {
                    const cards = Array.from(section.querySelectorAll('.product-card'));
                    const moreBtn = section.querySelector('.mobile-more-btn');
                    if (!moreBtn || cards.length === 0) {
                        return;
                    }

                    const chunk = Number(section.dataset.gridCollapse) || 4;
                    let visibleCount = Math.min(chunk, cards.length);

                    const applyVisibility = () => {
                        if (!mobileMedia.matches) {
                            cards.forEach((card) => card.classList.remove('is-hidden-mobile'));
                            moreBtn.hidden = true;
                            return;
                        }

                        moreBtn.hidden = cards.length <= chunk;
                        cards.forEach((card, index) => {
                            card.classList.toggle('is-hidden-mobile', index >= visibleCount);
                        });
                        moreBtn.textContent = visibleCount >= cards.length ? 'Hide' : 'More';
                    };

                    moreBtn.addEventListener('click', () => {
                        if (!mobileMedia.matches) {
                            return;
                        }
                        if (visibleCount >= cards.length) {
                            visibleCount = chunk;
                        } else {
                            visibleCount = Math.min(visibleCount + chunk, cards.length);
                        }
                        applyVisibility();
                    });

                    mobileMedia.addEventListener('change', () => {
                        if (!mobileMedia.matches) {
                            visibleCount = cards.length;
                        } else {
                            visibleCount = Math.min(Math.max(visibleCount, chunk), cards.length);
                        }
                        applyVisibility();
                    });

                    applyVisibility();
                });
            };

            if (!modal) {
                initGridControls();
                return;
            }

            const defaultModalImage =
                'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=80';
            const formatPrice = (value) =>
                `${new Intl.NumberFormat('th-TH').format(value)}.-`;

            const modalElements = {
                name: document.getElementById('modalProductName'),
                sku: document.getElementById('modalSku'),
                colorLabel: document.getElementById('modalColorValue'),
                stock: document.getElementById('modalStock'),
                category: document.getElementById('modalCategory'),
                description: document.getElementById('modalDescription'),
                img: document.getElementById('modalProductImage'),
                sizeSelect: document.getElementById('modalSize'),
                colorSelect: document.getElementById('modalColorSelect'),
                quantity: document.getElementById('modalQuantity'),
                addButton: document.querySelector('.add-to-cart-btn'),
                originalPrice: document.getElementById('modalOriginalPrice'),
                currentPrice: document.getElementById('modalCurrentPrice'),
            };

            let activeVariants = [];
            let currentProductData = null;
            let fallbackSizes = [];
            let fallbackColors = [];

            const safeParseVariants = (value) => {
                try {
                    const parsed = JSON.parse(value ?? '[]');
                    return Array.isArray(parsed) ? parsed : [];
                } catch (error) {
                    return [];
                }
            };

            const parseOptionList = (value) =>
                (value || '')
                    .split('|')
                    .map((entry) => entry.trim())
                    .filter(Boolean);

            const buildColorOptions = () => {
                if (!modalElements.colorSelect) {
                    return [];
                }

                const variantColors = activeVariants
                    .map((variant) => variant.color)
                    .filter(Boolean);
                const combined = Array.from(new Set([...variantColors, ...fallbackColors]));

                modalElements.colorSelect.innerHTML = '<option value="">เลือกสี</option>';

                if (combined.length === 0) {
                    const option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'สีเดียว';
                    modalElements.colorSelect.appendChild(option);
                    modalElements.colorSelect.disabled = true;
                } else {
                    modalElements.colorSelect.disabled = false;
                    combined.forEach((color, index) => {
                        const option = document.createElement('option');
                        option.value = color;
                        option.textContent = color;
                        if (index === 0) {
                            option.selected = true;
                        }
                        modalElements.colorSelect.appendChild(option);
                    });
                }

                return combined;
            };

            const buildSizeOptions = (colorFilter) => {
                if (!modalElements.sizeSelect) {
                    return [];
                }

                const variantSizes = activeVariants
                    .filter((variant) => !colorFilter || variant.color === colorFilter)
                    .map((variant) => variant.size)
                    .filter(Boolean);
                const combined = Array.from(new Set([...variantSizes, ...fallbackSizes]));
                const previousValue = modalElements.sizeSelect.value;

                modalElements.sizeSelect.innerHTML = '<option value="">เลือกไซส์</option>';

                if (combined.length === 0) {
                    const option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'Free Size';
                    modalElements.sizeSelect.appendChild(option);
                    modalElements.sizeSelect.disabled = true;
                } else {
                    modalElements.sizeSelect.disabled = false;
                    combined.forEach((size) => {
                        const option = document.createElement('option');
                        option.value = size;
                        option.textContent = size;
                        modalElements.sizeSelect.appendChild(option);
                    });
                }

                if (previousValue && combined.includes(previousValue)) {
                    modalElements.sizeSelect.value = previousValue;
                } else if (combined.length > 0) {
                    modalElements.sizeSelect.value = combined[0];
                }

                return combined;
            };

            const getActiveVariant = () => {
                if (!activeVariants.length) {
                    return null;
                }
                const selectedSize = modalElements.sizeSelect?.value || '';
                const selectedColor = modalElements.colorSelect?.value || '';

                let candidate = activeVariants.find(
                    (variant) =>
                        (!selectedSize || variant.size === selectedSize) &&
                        (!selectedColor || variant.color === selectedColor)
                );

                if (!candidate && selectedColor) {
                    candidate = activeVariants.find((variant) => variant.color === selectedColor);
                }

                if (!candidate && selectedSize) {
                    candidate = activeVariants.find((variant) => variant.size === selectedSize);
                }

                return candidate ?? activeVariants[0] ?? null;
            };

            const updateVariantDetails = () => {
                if (!currentProductData) {
                    return;
                }
                const selectedColor = modalElements.colorSelect?.value || '';
                const variant = getActiveVariant();
                const resolvedStock =
                    typeof variant?.stockQuantity === 'number'
                        ? variant.stockQuantity
                        : currentProductData.productStock || 0;

                modalElements.colorLabel.textContent =
                    selectedColor || variant?.color || currentProductData.productColor || '-';
                modalElements.stock.textContent = typeof resolvedStock === 'number' ? resolvedStock : '-';

                let currentQty = Number(modalElements.quantity.value) || 1;
                if (typeof resolvedStock === 'number' && resolvedStock > 0) {
                    if (currentQty > resolvedStock) {
                        currentQty = resolvedStock;
                        modalElements.quantity.value = String(resolvedStock);
                    }
                } else {
                    modalElements.quantity.value = '1';
                }

                if (modalElements.addButton) {
                    modalElements.addButton.disabled = !variant || (typeof variant.stockQuantity === 'number' && variant.stockQuantity <= 0);
                }
            };

            const handleAddToCart = async () => {
                if (!window.cartApi?.addItem) {
                    alert('ไม่สามารถเพิ่มสินค้าลงตะกร้าได้ในขณะนี้');
                    return;
                }

                const variant = getActiveVariant();
                if (!variant?.variantId) {
                    alert('กรุณาเลือกสีและไซส์ที่พร้อมจำหน่าย');
                    return;
                }

                const available = variant.stockQuantity ?? 0;
                if (available <= 0) {
                    alert('สินค้าหมดสต็อกแล้ว');
                    return;
                }

                const quantity = Number(modalElements.quantity.value) || 1;
                if (quantity > available) {
                    alert(`เลือกได้สูงสุด ${available} ชิ้นสำหรับตัวเลือกนี้`);
                    modalElements.quantity.value = String(available);
                    return;
                }

                try {
                    const response = await fetch(window.cartApi.addItem, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            variantId: variant.variantId,
                            quantity
                        })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        alert(result.message || 'ไม่สามารถเพิ่มสินค้าได้');
                        return;
                    }

                    variant.stockQuantity = result.item?.variantStock ?? available - quantity;
                    modalElements.quantity.value = '1';
                    updateVariantDetails();
                    alert('เพิ่มสินค้าในตะกร้าเรียบร้อยแล้ว');
                } catch (error) {
                    console.error(error);
                    alert('เกิดข้อผิดพลาด กรุณาลองอีกครั้ง');
                }
            };

            const openModal = (card) => {
                const data = { ...card.dataset };
                currentProductData = data;

                modalElements.name.textContent = data.productName ?? '';
                modalElements.sku.textContent = data.productSku ?? '';
                modalElements.category.textContent = data.productCategory ?? '-';
                modalElements.description.textContent = data.productDescription || '';

                modalElements.img.src = data.productImage || defaultModalImage;
                modalElements.img.alt = data.productName ?? 'Selected shoe';

                modalElements.quantity.value = '1';

                activeVariants = safeParseVariants(data.productVariants);
                fallbackSizes = parseOptionList(data.productSizes);
                fallbackColors = parseOptionList(data.productColors);
                buildColorOptions();
                const currentColor = modalElements.colorSelect?.value || '';
                buildSizeOptions(currentColor);
                updateVariantDetails();

                const basePrice = Number(data.productPrice ?? 0);
                const salePrice = data.productSale ? Number(data.productSale) : null;

                modalElements.currentPrice.textContent = formatPrice(salePrice ?? basePrice);
                modalElements.originalPrice.textContent = salePrice ? formatPrice(basePrice) : '';

                modal.classList.add('is-visible');
                body.classList.add('modal-open');
                modal.setAttribute('aria-hidden', 'false');
            };

            const closeModal = () => {
                modal.classList.remove('is-visible');
                body.classList.remove('modal-open');
                modal.setAttribute('aria-hidden', 'true');
                currentProductData = null;
                activeVariants = [];
            };

            document.querySelectorAll('.product-card').forEach((card) => {
                const trigger = () => openModal(card);
                card.addEventListener('click', trigger);
                card.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        trigger();
                    }
                });
            });

            modal.querySelectorAll('[data-modal-close]').forEach((btn) => {
                btn.addEventListener('click', closeModal);
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && modal.classList.contains('is-visible')) {
                    closeModal();
                }
            });

            modalElements.sizeSelect?.addEventListener('change', updateVariantDetails);
            modalElements.colorSelect?.addEventListener('change', () => {
                buildSizeOptions(modalElements.colorSelect.value);
                updateVariantDetails();
            });
            modalElements.addButton?.addEventListener('click', handleAddToCart);

            const adjustQuantity = (direction) => {
                let current = Number(modalElements.quantity.value) || 1;
                const variant = getActiveVariant();
                const available = variant?.stockQuantity ?? Infinity;

                if (direction === 'minus') {
                    current = Math.max(1, current - 1);
                    modalElements.quantity.value = String(current);
                    return;
                }

                if (direction === 'plus') {
                    if (Number.isFinite(available) && available <= current) {
                        alert(`เลือกได้สูงสุด ${available} ชิ้นสำหรับตัวเลือกนี้`);
                        return;
                    }
                    modalElements.quantity.value = String(current + 1);
                }
            };

            modal.querySelectorAll('.qty-btn').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const action = btn.dataset.qtyAction;
                    if (!action) {
                        return;
                    }
                    adjustQuantity(action);
                });
            });

            initGridControls();
        })();
    </script>
}


