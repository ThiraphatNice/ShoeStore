@model ShoeStore.ViewModels.Home.HomePageViewModel
@using ShoeStore.ViewModels.Home
@{
    ViewData["Title"] = "Home Page";
    var cartRestricted = false;
    if (User?.Identity?.IsAuthenticated == true)
    {
        cartRestricted = User.IsInRole("Admin")
            || User.IsInRole("Staff")
            || User.Claims.Any(c =>
                c.Type == ClaimTypes.Role &&
                c.Value.StartsWith("Staff", System.StringComparison.OrdinalIgnoreCase));
    }
}

@section Styles {
    @await Html.PartialAsync("_ProductCatalogStyles")
}
<section class="home-hero">
    <h1>Welcome to Shoes Store</h1>
    @if (!string.IsNullOrEmpty(Model.Username))
    {
        <p>Hello, @Model.Username! Enjoy the latest drops tailored for you.</p>
    }
    else
    {
        <p>Discover curated sneakers, sport shoes, and everyday essentials.</p>
    }
</section>

@if (Model.FeaturedProducts.Any())
{
    var featuredSection = new HomeSectionViewModel
    {
        Title = "Hot Deals",
        Products = Model.FeaturedProducts
    };
    @await Html.PartialAsync("~/Views/Shared/_ProductSection.cshtml", featuredSection)
}

@if (Model.LimitedProducts.Any())
{
    var limitedSection = new HomeSectionViewModel
    {
        Title = "Limited Edition Spotlight",
        Products = Model.LimitedProducts
    };
    @await Html.PartialAsync("~/Views/Shared/_ProductSection.cshtml", limitedSection)
}

@foreach (var section in Model.CategorySections)
{
    @await Html.PartialAsync("~/Views/Shared/_ProductSection.cshtml", section)
}

@await Html.PartialAsync("_ProductModal")

@section Scripts {
    <script>
        window.cartApi = Object.assign(window.cartApi || {}, {
            addItem: '@Url.Action("AddItem", "Cart")'
        });
        window.cartRestrictions = Object.assign(window.cartRestrictions || {}, {
            isDisabled: @(cartRestricted.ToString().ToLowerInvariant()),
            message: 'บัญชีแอดมินและพนักงานไม่สามารถซื้อสินค้าได้'
        });
    </script>
    @await Html.PartialAsync("_ProductCatalogScripts")
}



