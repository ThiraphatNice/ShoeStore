@{
    ViewData["Title"] = "Sales & Promotions";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h1 class="fw-bold">Sales & Promotions</h1>
            <p class="text-muted">ออกแบบแคมเปญและคูปองใหม่ ๆ สำหรับรองเท้าแตะ/รองเท้าผ้าใบ</p>
        </div>
    </div>
    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">ตั้งค่าโปรโมชัน</h5>
                    <p class="card-text">สร้างโปรสมาชิกใหม่, ซื้อ 2 คู่ลดเพิ่ม, หรือโปรโมชันลิมิเต็ด</p>
                    <span class="badge rounded-pill text-bg-warning">Coming soon</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">คูปองและโค้ดส่วนลด</h5>
                    <p class="card-text">จัดการโค้ดส่วนลดพร้อมกำหนดช่วงเวลาและเงื่อนไขใช้งาน</p>
                    <span class="badge rounded-pill text-bg-warning">Coming soon</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">รายงานผล</h5>
                    <p class="card-text">ดูสถิติยอดขายจากแต่ละแคมเปญเพื่อนำไปปรับปรุงโปรโมชันถัดไป</p>
                    <span class="badge rounded-pill text-bg-warning">Coming soon</span>
                </div>
            </div>
        </div>
    </div>
</div>
