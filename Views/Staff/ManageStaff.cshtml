@model ShoeStore.ViewModels.StaffManagementViewModel
@{
    ViewData["Title"] = "Admin Control Center";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-lg-8">
            <h1 class="fw-bold">Admin Control Center</h1>
            <p class="text-muted">จัดการบัญชีพนักงานและกำหนดสิทธิ์การทำงานในระบบ</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">เพิ่มบัญชีใหม่</h5>
                    <form asp-action="CreateStaff" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="NewStaff.FullName" class="form-label"></label>
                            <input asp-for="NewStaff.FullName" class="form-control" />
                            <span asp-validation-for="NewStaff.FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewStaff.Email" class="form-label"></label>
                            <input asp-for="NewStaff.Email" type="email" class="form-control" />
                            <span asp-validation-for="NewStaff.Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewStaff.Password" class="form-label"></label>
                            <input asp-for="NewStaff.Password" type="password" class="form-control" />
                            <span asp-validation-for="NewStaff.Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewStaff.ConfirmPassword" class="form-label"></label>
                            <input asp-for="NewStaff.ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="NewStaff.ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewStaff.RoleId" class="form-label"></label>
                            <select asp-for="NewStaff.RoleId" asp-items="Model.RoleOptions" class="form-select">
                                <option value="">-- เลือกสิทธิ์ --</option>
                            </select>
                            <span asp-validation-for="NewStaff.RoleId" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">สร้างบัญชี</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">บัญชีที่มีอยู่</h5>
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>ชื่อ</th>
                                    <th>อีเมล</th>
                                    <th>สิทธิ์</th>
                                    <th>สร้างเมื่อ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.ExistingUsers.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">ยังไม่มีบัญชี</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var user in Model.ExistingUsers)
                                    {
                                        <tr>
                                            <td>@user.FullName</td>
                                            <td>@user.Email</td>
                                            <td>@user.RoleName</td>
                                            <td>@user.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
