@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h1 class="fw-bold">Operations Hub</h1>
            <p class="text-muted">สรุปงานหลังบ้าน ดูแลระบบ ติดตามคำสั่งซื้อ และตรวจสอบการทำงานของทีม</p>
        </div>
    </div>
    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">ภาพรวมคำสั่งซื้อ</h5>
                    <p class="card-text">แสดงคำสั่งซื้อที่รอดำเนินการ การชำระเงินที่ต้องตรวจสอบ และคำสั่งซื้อที่ต้องติดตาม</p>
                    <span class="badge rounded-pill text-bg-warning">Coming soon</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">ตรวจสอบระบบ</h5>
                    <p class="card-text">บันทึกการเข้าใช้งาน แจ้งเตือนปัญหา และประสานงานกับทีมพัฒนาเมื่อพบความผิดปกติ</p>
                    <span class="badge rounded-pill text-bg-warning">Coming soon</span>
                </div>
            </div>
        </div>
    </div>
</div>
