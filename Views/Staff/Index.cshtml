@model ShoeStore.ViewModels.StaffDashboardViewModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

@section Styles {
    <style>
        .staff-card {
            background: #fff;
            border-radius: 28px;
            padding: 32px;
            border: 1px solid rgba(0, 0, 0, 0.04);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
        }

        .dashboard-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .selector-row {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            align-items: center;
        }

        .selector-row .form-select {
            min-width: 240px;
            flex: 1;
            border-radius: 16px;
            padding: 10px 14px;
        }

        .selector-row .btn {
            min-width: 160px;
        }

        .selector-hint {
            font-size: 0.9rem;
            margin-top: 8px;
        }

        .section-pill-group {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .section-pill {
            padding: 6px 16px;
            border-radius: 999px;
            background: #fdecec;
            color: #7d2424;
            font-weight: 500;
            font-size: 0.9rem;
        }
    </style>
}

<div class="staff-dashboard container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="staff-card shadow-sm">
                <div class="dashboard-head">
                    <div>
                        <p class="eyebrow text-uppercase">Staff Portal</p>
                        <h1 class="fw-bold mb-2">Staff Dashboard</h1>
                        <p class="text-muted mb-0">เลือกส่วนงานที่คุณรับผิดชอบและเริ่มจัดการงานได้จากที่นี่</p>
                    </div>
                </div>
                <div class="dashboard-selector mt-4">
                    <label for="sectionSelector" class="form-label fw-semibold">เลือกส่วนงาน</label>
                    <div class="selector-row">
                        <select id="sectionSelector" class="form-select" @(Model.Sections.Any() ? string.Empty : "disabled")>
                            <option value="">-- เลือกส่วนงาน --</option>
                            @foreach (var area in Model.Sections)
                            {
                                <option value="@Url.Action(area.ActionName, "Staff")">@area.DisplayName</option>
                            }
                        </select>
                        <button type="button" id="goToSection" class="btn btn-auth-primary" @(Model.Sections.Any() ? string.Empty : "disabled")>
                            ไปหน้าจัดการ
                        </button>
                    </div>
                    <p class="selector-hint text-muted">ระบบจะแสดงเฉพาะหน้าที่ที่คุณได้รับสิทธิ์เท่านั้น</p>
                </div>
                @if (Model.Sections.Any())
                {
                    <div class="section-pill-group mt-4">
                        @foreach (var area in Model.Sections)
                        {
                            <span class="section-pill">@area.DisplayName</span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-muted mb-0">ยังไม่มีสิทธิ์เข้าถึงส่วนงานของ Staff</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const select = document.getElementById('sectionSelector');
            const button = document.getElementById('goToSection');
            if (!button || !select) {
                return;
            }

            button.addEventListener('click', () => {
                if (!select.value) {
                    select.classList.add('is-invalid');
                    return;
                }
                window.location.href = select.value;
            });

            select.addEventListener('change', () => {
                select.classList.remove('is-invalid');
            });
        })();
    </script>
}
