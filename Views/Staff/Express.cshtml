@{
    ViewData["Title"] = "Express Logistics";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h1 class="fw-bold">Express Logistics</h1>
            <p class="text-muted">รับผิดชอบการแพ็คสินค้าและประสานงานขนส่งให้ถึงมือลูกค้า</p>
        </div>
    </div>
    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">คิวการแพ็ค</h5>
                    <p class="card-text">จัดลำดับออเดอร์ที่ต้องแพ็คและตรวจสอบ SLA การส่งมอบ</p>
                    <span class="badge rounded-pill text-bg-warning">Coming soon</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">หมายเลขติดตาม</h5>
                    <p class="card-text">บันทึก Tracking Number และสถานะการจัดส่งให้ลูกค้าติดตามได้</p>
                    <span class="badge rounded-pill text-bg-warning">Coming soon</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">รายงานปัญหา</h5>
                    <p class="card-text">แจ้งปัญหาพัสดุและสรุปเคสที่ต้องติดตามพิเศษ</p>
                    <span class="badge rounded-pill text-bg-warning">Coming soon</span>
                </div>
            </div>
        </div>
    </div>
</div>
